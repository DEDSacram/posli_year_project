<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:padding="8dp"
    android:background="@android:color/white">

    <ImageView android:id="@+id/thumb" android:layout_width="96dp"
        android:layout_height="96dp" android:scaleType="centerCrop"
        android:background="@android:color/darker_gray" />

    <LinearLayout android:orientation="vertical" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1"
        android:paddingStart="10dp">

        <TextView android:id="@+id/title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textStyle="bold"
            android:textSize="16sp" android:maxLines="2" android:ellipsize="end" />

        <TextView android:id="@+id/price" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="17sp"
            android:textColor="@color/navydeep" android:textStyle="bold" />

        <TextView android:id="@+id/meta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
